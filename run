#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FRONTEND_DIR="$ROOT_DIR/frontend"
cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
Usage: ./run <start|process|format>

Commands:
  start        Start the local dashboard at http://127.0.0.1:5000
  process      Rebuild dashboard.json directly from all original screenshots
  format       Format frontend files with Prettier and Python files with Ruff

The process and format commands accept no arguments.
EOF
}

command_name=${1:-}
if [ "$#" -gt 0 ]; then
  shift
fi

if [ -z "${PYTHON:-}" ]; then
  if [ -x "$ROOT_DIR/.venv/bin/python" ]; then
    PYTHON="$ROOT_DIR/.venv/bin/python"
  else
    PYTHON="python3"
  fi
fi

case "$command_name" in
  start)
    exec npm --prefix "$FRONTEND_DIR" run dev -- --port 5000 --strictPort "$@"
    ;;
  process)
    if [ "$#" -ne 0 ]; then
      printf '%s\n' 'The process command accepts no arguments. Use ./run process.' >&2
      exit 2
    fi
    exec "$PYTHON" -m processing process
    ;;
  format)
    if [ "$#" -ne 0 ]; then
      printf '%s\n' 'The format command accepts no arguments. Use ./run format.' >&2
      exit 2
    fi
    if ! "$PYTHON" -m ruff --version >/dev/null 2>&1; then
      printf '%s\n' "Ruff is missing. Run $PYTHON -m pip install -r processing/requirements.txt first." >&2
      exit 1
    fi
    if [ ! -f "$FRONTEND_DIR/node_modules/prettier/package.json" ]; then
      printf '%s\n' 'Prettier is missing. Run npm --prefix frontend ci first.' >&2
      exit 1
    fi
    npm --prefix "$FRONTEND_DIR" run format
    exec "$PYTHON" -m ruff format --extend-exclude processing/data processing
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
